{
  "info": {
    "name": "LOQAH API",
    "description": "Starter API tests for LOQAH. Select the LOQAH - Local and Render environment. Register or login stores the JWT in the token variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "destinationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const body = pm.response.json(); pm.environment.set('token', body.token); if (body.user) pm.test('Registration returns user', () => pm.expect(body.user.email).to.exist); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"LOQAH Explorer\",\n  \"email\": \"explorer@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.environment.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"explorer@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Destinations",
      "item": [
        {
          "name": "List destinations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const rows = pm.response.json(); if (rows.length) pm.environment.set('destinationId', rows[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/destinations"
          }
        },
        {
          "name": "Filter by state",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/destinations?state=Karnataka"
          }
        },
        {
          "name": "Filter by category",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/destinations?category=waterfall"
          }
        },
        {
          "name": "Destination details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/destinations/{{destinationId}}"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/profile/me"
      }
    },
    {
      "name": "Visits",
      "item": [
        {
          "name": "Create visit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \"destinationId\": \"{{destinationId}}\",\\n  \"note\": \"A memorable day exploring this destination.\"\\n}"
            },
            "url": "{{baseUrl}}/visits"
          }
        },
        {
          "name": "List my visits",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/visits"
          }
        }
      ]
    }
  ]
}
